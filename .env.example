# Firebase Client Configuration for ECE Connect
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="ece-connect-fcb2d.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="ece-connect-fcb2d"
VITE_FIREBASE_STORAGE_BUCKET="ece-connect-fcb2d.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Configurable Institutional Email Regex Pattern
# Covers S7 (pkd23ec), S5 (pkd24ec), S3 (pkd25ec), S1 (pkd26ec) up to roll 075
VITE_STUDENT_EMAIL_REGEX=^pkd(2[3-6]|2x)ec0(0[1-9]|[1-6][0-9]|7[0-5])@gecskp\.ac\.in$
