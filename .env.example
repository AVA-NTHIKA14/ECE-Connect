# ==============================================================================
# ECE Connect — Environment Configuration Template
# Government Engineering College Sreekrishnapuram Palakkad (GECP)
# Department of Electronics & Communication Engineering
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to `.env.local` or `.env` and populate with your authorized credentials.
# Never commit real API keys, passkeys, or service secrets to version control.
# ==============================================================================

# Firebase Web App Credentials (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Department Representative Portal Security Passkey
# Required for representative authentication (ece.rep@gecskp.ac.in)
VITE_REP_PASSKEY=ecerep@2026

# Institutional Student Email Validation Pattern (Optional regex override)
# Default matches S1-S7 ECE batch rolls (pkd23ec001-pkd26ec075@gecskp.ac.in)
VITE_STUDENT_EMAIL_REGEX=^pkd(2[3-6]|2x)ec0(0[1-9]|[1-6][0-9]|7[0-5])@gecskp\.ac\.in$
